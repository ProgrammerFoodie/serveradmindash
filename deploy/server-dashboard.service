[Unit]
Description=Server admin dashboard
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/Extra20

[Service]
Type=simple
WorkingDirectory=/mnt/Extra20/admin
ExecStart=/usr/bin/python3 -m dashboard serve
# Root is needed to kill any process, restart services and read the fail2ban and supervisor sockets.
User=root
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
Nice=10
IOSchedulingClass=idle
# The app is ~20 MB; the rest is room for `apt list`, which briefly needs about 80 MB.
MemoryMax=192M
OOMPolicy=continue
NoNewPrivileges=yes
PrivateTmp=yes
# The admin tools (users, SSH keys, config editor) have to edit /etc, home folders, crontabs and mail spools, so the sandbox is
# opened exactly that far: /usr, /boot and the rest of /var stay read-only. /mnt/Extra20 is the data disk (where this program lives
# and where homes may be): without it in this list the disk is read-only to the service and `usermod -m` cannot move a home there.
# To allow homes on another disk, add its mount point here (or in a drop-in) and restart the service.
ProtectHome=no
ProtectSystem=strict
ReadWritePaths=/mnt/Extra20 /etc /home /root -/var/spool/cron -/var/mail

[Install]
WantedBy=multi-user.target
